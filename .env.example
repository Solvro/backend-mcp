# App
APP_NAME=ml-mcp-backend
LOG_LEVEL=INFO

# "env" reads secrets from the environment, falling back to <NAME>_FILE paths
SECRETS_BACKEND=env

# Prometheus scrape endpoint on every service
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
# Per-dependency probe budget for /health/ready
HEALTH_PROBE_TIMEOUT_SECONDS=3.0
# Bodies above this are rejected with 413 (nginx enforces the same limit at the edge)
MAX_REQUEST_BODY_SIZE=1048576

# CORS as seen by the services themselves (JSON lists). Behind nginx the edge is authoritative
# and strips these headers from upstream responses; these matter for host-side runs only.
CORS_ALLOW_ORIGINS=["http://localhost:8000","http://localhost:8080"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS=["x-request-id","x-trace-id","x-process-time","x-session-id","x-user-id"]

# Generic per-client request cap (chat-service overrides RATE_LIMIT to 30); auth-service
# has per-endpoint caps further down. RATE_LIMIT_ENABLED=false only for local debugging.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60

# Error Type Url
ERROR_TYPE_BASE_URL=

# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=mcp_backend
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_backend
DATABASE_URL_FILE=
# SQLAlchemy async pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Mongo database
MONGO_URI=mongodb://localhost:27017
MONGO_URI_FILE=
MONGO_DB_NAME=mcp_backend
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_FILE=
# Namespace prefix for all Redis keys (rate-limit / denylist / cache)
REDIS_KEY_PREFIX=mcp

# Leave unset: compose then defaults to http://mcp-server:8005/mcp over the shared
# solvro-mcp-internal network, and a host-side run defaults to http://localhost:8005/mcp
# (against `just up-dev` in ml-mcp). An empty `MCP_SERVER_URL=` is not "unset" to
# pydantic-settings; it makes the host-side URL an empty string.
# MCP_SERVER_URL=
# ml-mcp call budget. MCP_TIMEOUT_SECONDS must cover ml-mcp's own run budget
MCP_TIMEOUT_SECONDS=95.0
MCP_INIT_TIMEOUT_SECONDS=10.0
MCP_MAX_RETRIES=2
MCP_RETRY_BASE_DELAY=0.2
MCP_RETRY_MAX_DELAY=2.0
MCP_BREAKER_ENABLED=true
MCP_BREAKER_FAILURE_THRESHOLD=5
MCP_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# Peers whose X-Forwarded-For uvicorn may believe (IPs or CIDRs, comma-separated). The compose
# default is nginx's fixed address; add a load balancer here if one is put in front of nginx.
# Leave unset when running a service on the host without nginx.
# FORWARDED_ALLOW_IPS=

# Per-day chat message quota
CHAT_DAILY_QUOTA_ANONYMOUS=5
CHAT_DAILY_QUOTA_AUTHENTICATED=8
# Message length bounds and how much history is replayed to the model
CHAT_INPUT_MIN_LENGTH=1
CHAT_INPUT_MAX_LENGTH=2000
CONTEXT_MAX_MESSAGES=6
CONTEXT_MAX_CHARS=8000

# Anonymous conversations auto-expire after this many days
ANONYMOUS_RETENTION_DAYS=30

# Auth services
# auth-service signs, chat-service verifies. RS256 (default) needs the PEM keypair below;
# HS256 needs JWT_SECRET_KEY instead. auth-service refuses to start if the matching key is missing.
# For local dev: `just e2e-keys` writes a throwaway pair to docker/.e2e-keys/.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEY_FILE=
JWT_SECRET_KEY=
JWT_SECRET_KEY_FILE=
# Optional issuer/audience checks, clock-skew tolerance in seconds.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Per-endpoint request caps for auth-service, all within RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_RESEND=3
RATE_LIMIT_REFRESH=30
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_RESET_PASSWORD=10
RATE_LIMIT_CHANGE_PASSWORD=5
FRONTEND_URL=
VERIFICATION_TOKEN_TTL_MINUTES=120
VERIFICATION_COOLDOWN_MINUTES=1
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_MINUTES=1
# Argon2id parameters (RFC 9106 second recommended set) and password length ceiling
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
MAX_PASSWORD_LENGTH=128

# LLM API keys
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
GOOGLE_API_KEY=
GOOGLE_API_KEY_FILE=

# Answer-generation model. Leave ANSWER_MODEL_PROVIDER empty to auto-select
ANSWER_MODEL_PROVIDER=
ANSWER_OPENAI_MODEL=gpt-5.4-mini
ANSWER_GEMINI_MODEL=gemini-2.5-flash-lite
ANSWER_TEMPERATURE=0.0
# MCP runs per tool call when the graph has nothing. ml-mcp escalates internally at
# temperature 0, so re-sending the identical query buys nothing; >1 is for experiments.
ANSWER_KG_RETRIEVAL_ATTEMPTS=1

ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600

# Batched embeddings. Off by default.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
EMBEDDING_GEMINI_MODEL=text-embedding-004
EMBEDDING_BATCH_MAX_SIZE=128
EMBEDDING_BATCH_WINDOW_MS=10.0
EMBEDDING_MAX_CONCURRENT_BATCHES=4

# Similarity cache layer. Active when EMBEDDING_ENABLED=true.
ANSWER_CACHE_SIMILARITY_THRESHOLD=0.92
ANSWER_CACHE_SIMILARITY_MAX_ENTRIES=100

SEMANTIC_GUARDRAIL_ENABLED=false
SEMANTIC_GUARDRAIL_TEMPERATURE=0.0

# Langfuse observability, enabled only when BOTH keys are set
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET_KEY_FILE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_PUBLIC_KEY_FILE=
LANGFUSE_HOST=https://cloud.langfuse.com

# Outbound email (FND-8). SMTP_PROVIDER=smtp; local compose points at Mailpit.
SMTP_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_PASS_FILE=
SMTP_FROM=no-reply@example.com
# From-address used by auth-service templates
EMAIL_FROM=noreply@example.com
# Set to true to enable STARTTLS, if supported
SMTP_STARTTLS=false
SMTP_TIMEOUT=10
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY=0.5
EMAIL_RETRY_MAX_DELAY=5.0
