# App
APP_NAME=ml-mcp-backend
LOG_LEVEL=INFO

SECRETS_BACKEND=env

# Error Type Url
ERROR_TYPE_BASE_URL=

# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=mcp_backend
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_backend
DATABASE_URL_FILE=
# SQLAlchemy async pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Mongo database
MONGO_URI=mongodb://localhost:27017
MONGO_URI_FILE=
MONGO_DB_NAME=mcp_backend
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_FILE=
# Namespace prefix for all Redis keys (rate-limit / denylist / cache)
REDIS_KEY_PREFIX=mcp

MCP_SERVER_URL=

# Auth services
JWT_SECRET_KEY=
JWT_SECRET_KEY_FILE=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM API keys
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
GOOGLE_API_KEY=
GOOGLE_API_KEY_FILE=
CLARIN_API_KEY=
CLARIN_API_KEY_FILE=
