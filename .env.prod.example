SECRETS_DIR=/etc/ml-mcp/secrets

# Edge (behind Coolify, which terminates TLS for mcpwr.solvro.pl)
# Address(es) allowed to set X-Forwarded-For. 127.0.0.1/32 trusts no one; once Coolify is
# connected, set it from `mcpwr-deploy backend proxies` (docs/deploy.md).
TRUSTED_PROXY_CIDR=127.0.0.1/32

POSTGRES_USER=mcp
POSTGRES_DB=mcp_backend
MONGO_ROOT_USER=mcp

# Services
LOG_LEVEL=INFO
FRONTEND_URL=https://mcpwr.solvro.pl
JWT_ISSUER=auth-service
JWT_AUDIENCE=ml-mcp-backend
MCP_SERVER_URL=http://mcp-server:8005/mcp
ANSWER_MODEL_PROVIDER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Outbound mail (SMTP_PASS is a secret file)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
