SECRETS_DIR=/etc/ml-mcp/secrets

# Edge
SERVER_NAME=api.example.com
CORS_ALLOWED_ORIGIN=https://app.example.com

POSTGRES_USER=mcp
POSTGRES_DB=mcp_backend
MONGO_ROOT_USER=mcp

# Services
LOG_LEVEL=INFO
FRONTEND_URL=https://app.example.com
JWT_ISSUER=auth-service
JWT_AUDIENCE=ml-mcp-backend
MCP_SERVER_URL=http://mcp-server:8005/mcp
ANSWER_MODEL_PROVIDER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Outbound mail (SMTP_PASS is a secret file)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
