# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Environment variables
.env

# Ephemeral e2e JWT keypair (just e2e-keys)
docker/.e2e-keys/

# Local self-signed TLS pair for the edge (just tls-selfsigned)
docker/.tls/

# Production env (non-secret config, but machine-specific)
.env.prod

# Virtual environments
.venv

# Test / coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
